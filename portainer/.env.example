# =============================================================================
# Configuration Portainer
# -----------------------------------------------------------------------------
# Copier en `.env` puis :  chmod 600 .env
# Ces deux variables sont OBLIGATOIRES : sans elles, `docker compose up`
# refuse de démarrer (protection volontaire — Portainer administre l'hôte).
# =============================================================================

# Domaine d'accès à Portainer via Traefik (TLS automatique Let's Encrypt)
DOMAIN_NAME=portainer.exemple.com

# Identifiant de la protection d'accès (authentification basique Traefik)
PORTAINER_AUTH_USER=admin

# Hash du mot de passe (JAMAIS le mot de passe en clair).
# Génération :  htpasswd -nbB admin 'monmotdepasse'
#   -> copier UNIQUEMENT la partie après "admin:"
# Le `$` du hash bcrypt est consommé par Compose : doubler chaque `$`
# (ex. $2y$05$abc -> $$2y$$05$$abc).
PORTAINER_AUTH_PASSWORD_HASH=$$2y$$05$$remplacer.par.le.hash.bcrypt
