# =============================================================================
# Variables d'un site — copié par deploy.sh puis complété automatiquement.
# -----------------------------------------------------------------------------
# ⚠️ Ce fichier contient des mots de passe : il doit être en chmod 600 et ne
#    doit JAMAIS être versionné (voir .gitignore).
# =============================================================================

# --- Identité du site --------------------------------------------------------
SITE_NAME=demo
DOMAIN_NAME=demo.exemple.com

# --- Base de données ---------------------------------------------------------
MYSQL_ROOT_PASSWORD=remplacer
MYSQL_DATABASE=wordpress_demo
MYSQL_USER=wordpress_demo
MYSQL_PASSWORD=remplacer
# Dimensionner selon la RAM du VPS : 128M pour 1 Go, 256M pour 2 Go et plus.
INNODB_BUFFER_POOL_SIZE=256M

# --- Cache -------------------------------------------------------------------
REDIS_PASSWORD=remplacer
REDIS_VERSION=7-alpine

# --- WordPress ---------------------------------------------------------------
MYSQL_VERSION=10.11
WORDPRESS_IMAGE=eflexcloud/wordpress-custom
WP_TABLE_PREFIX=wp_
WP_LANG=fr_FR
WP_DEBUG=false
WP_MEMORY_LIMIT=256M
WP_MAX_MEMORY_LIMIT=512M
WP_POST_MAX_SIZE=64M
WP_UPLOAD_MAX_FILESIZE=64M
