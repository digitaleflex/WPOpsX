# =============================================================================
# Configuration de la stack monitoring
# -----------------------------------------------------------------------------
# Copier en `.env` puis :  chmod 600 .env
# TOUTES ces variables sont obligatoires : `docker compose up` refuse de
# démarrer si l'une manque (protection volontaire, voir README).
# =============================================================================

# Domaine principal ; les interfaces sont exposées sur les sous-domaines
# prometheus.<DOMAIN_NAME>, grafana.<DOMAIN_NAME>, jaeger.<DOMAIN_NAME>
DOMAIN_NAME=exemple.com

# --- Authentification des interfaces (Traefik basicauth) ---------------------
MONITORING_AUTH_USER=admin
# Hash bcrypt (JAMAIS le mot de passe en clair) :  htpasswd -nbB admin 'mdp'
# Copier la partie après "admin:", et DOUBLER chaque `$` (Compose les consomme).
MONITORING_AUTH_PASSWORD_HASH=$$2y$$05$$remplacer.par.le.hash.bcrypt

# --- Grafana -----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
# Aucune valeur par défaut : choisir un mot de passe long et unique.
GRAFANA_ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-long-et-unique
