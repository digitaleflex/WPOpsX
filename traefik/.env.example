# =============================================================================
# Configuration Traefik — OPTIONNEL
# -----------------------------------------------------------------------------
# Ce fichier n'est PAS requis pour démarrer Traefik : la configuration livrée
# fonctionne sans aucun .env (l'email ACME est écrit en dur dans traefik.yml,
# car les ${VAR} n'y sont pas interpolés — c'est une contrainte Traefik).
#
# Il ne sert qu'à activer le dashboard sécurisé (labels à décommenter dans
# docker-compose.yml). Copier en `.env`, puis :  chmod 600 .env
# =============================================================================

# Domaine du dashboard (sous-domaine dédié, ne doit pas être un site client)
DOMAIN_NAME=traefik.exemple.com

# Identifiant du dashboard Traefik (authentification basique)
TRAEFIK_DASHBOARD_USER=admin

# Hash du mot de passe (JAMAIS le mot de passe en clair).
# Génération :  htpasswd -nbB admin 'monmotdepasse'
#   -> copier UNIQUEMENT la partie après "admin:"
# Le `$` du hash bcrypt est consommé par Compose : doubler chaque `$`
# (ex. $2y$05$abc -> $$2y$$05$$abc).
TRAEFIK_DASHBOARD_PASSWORD_HASH=$$2y$$05$$remplacer.par.le.hash.bcrypt
